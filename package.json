{
  "name": "office-survivor",
  "version": "1.0.0",
  "private": true,
  "description": "A browser-playable office roguelite where you survive an 8-hour workday.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "node server.js",
    "build": "vite build",
    "cf:dev": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "lint": "tsc --noEmit",
    "test": "npx --yes tsx --test src/game/rules.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/three": "^0.187.0",
    "express": "^5.1.0",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
